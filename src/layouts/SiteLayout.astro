---
import CursorTracker from '../components/CursorTracker';
import CarSelector from '../components/CarSelector';
import SpriteStackFollower from '../components/SpriteStackFollower';
import ThemeToggle from '../components/ThemeToggle';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
		<title>{title}</title>
		<script is:inline>
			const savedTheme = localStorage.getItem('theme-preference');
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			const initialTheme = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : prefersDark ? 'dark' : 'light';
			document.documentElement.setAttribute('data-theme', initialTheme);
		</script>
	</head>
	<body>
		<div class="stars stars-far" aria-hidden="true"></div>
		<div class="stars stars-mid" aria-hidden="true"></div>
		<div class="stars stars-near" aria-hidden="true"></div>
		<div class="nebula-overlay" aria-hidden="true"></div>
		<div class="scanline-overlay" aria-hidden="true"></div>
		<header class="site-header">
			<div class="header-inner">
				<a class="brand" href="/">Wessel Wegerif</a>
				<div class="header-actions">
					<nav>
						<a href="/">Home</a>
						<a href="/about">About</a>
						<a href="/posts">Posts</a>
						<a href="/style-lab">Style Lab</a>
						<a href="/contact">Contact</a>
					</nav>
					<CarSelector client:load />
					<ThemeToggle client:load />
				</div>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<SpriteStackFollower client:load />
		<CursorTracker client:load />
		<footer class="site-footer">
			<p>Built with Astro + React. Powered by headless WordPress content.</p>
		</footer>
	</body>
</html>

<style>
	:root,
	:root[data-theme='dark'] {
		--bg: #020b07;
		--bg-2: #04130d;
		--bg-accent-1: #113423;
		--bg-accent-2: #0a263f;
		--surface: rgba(7, 22, 14, 0.82);
		--surface-strong: #0a1b13;
		--panel-bg: linear-gradient(180deg, rgba(6, 22, 12, 0.95), rgba(3, 16, 7, 0.95));
		--panel-border: rgba(137, 251, 180, 0.32);
		--panel-hover: rgba(125, 249, 255, 0.38);
		--text: #e6ffef;
		--muted: #9bc1a8;
		--accent: #89fbb4;
		--accent-2: #7df9ff;
		--accent-3: #ffc857;
		--header-bg: rgba(4, 14, 9, 0.76);
		--header-border: rgba(137, 251, 180, 0.35);
		--header-link-bg: rgba(7, 28, 16, 0.8);
		--header-link-border: rgba(137, 251, 180, 0.3);
		--header-link-hover: rgba(16, 48, 28, 0.9);
		--header-brand: #b8ffd6;
		--font-body: 'Cascadia Code', Consolas, 'Lucida Console', monospace;
		--font-display: 'Press Start 2P', 'Cascadia Code', Consolas, monospace;
		--heading: #b8ffd6;
		--heading-letter-spacing: 0.05em;
		--heading-line-height: 1.35;
		--heading-word-spacing: 0.08em;
		--cursor-dot: #e6fff0;
		--cursor-dot-glow: rgba(137, 251, 180, 0.95);
		--cursor-ring: rgba(137, 251, 180, 0.95);
		--cursor-ring-glow: rgba(137, 251, 180, 0.45);
		--cursor-ring-pressed: rgba(125, 249, 255, 0.95);
		--cursor-ring-pressed-glow: rgba(125, 249, 255, 0.65);
		--overlay-opacity: 0.1;
	}

	:root[data-theme='light'] {
		--bg: #eef6ff;
		--bg-2: #dceeff;
		--bg-accent-1: #d6e8ff;
		--bg-accent-2: #beddff;
		--surface: rgba(255, 255, 255, 0.84);
		--surface-strong: rgba(243, 249, 255, 0.96);
		--panel-bg: linear-gradient(180deg, rgba(193, 224, 255, 0.55), rgba(68, 124, 224, 0.22));
		--panel-border: rgba(186, 222, 255, 0.92);
		--panel-hover: rgba(66, 132, 235, 0.42);
		--text: #16264a;
		--muted: #3a5383;
		--accent: #2f6ee5;
		--accent-2: #a94de3;
		--accent-3: #cc8a00;
		--header-bg: rgba(255, 255, 255, 0.78);
		--header-border: rgba(186, 222, 255, 0.92);
		--header-link-bg: rgba(255, 255, 255, 0.75);
		--header-link-border: rgba(99, 150, 221, 0.3);
		--header-link-hover: rgba(226, 240, 255, 0.92);
		--header-brand: #284987;
		--font-body: 'Segoe UI', 'Inter', Tahoma, sans-serif;
		--font-display: 'Trebuchet MS', 'Segoe UI', sans-serif;
		--heading: #2f58a2;
		--heading-letter-spacing: 0.02em;
		--heading-line-height: 1.2;
		--heading-word-spacing: normal;
		--cursor-dot: #ffffff;
		--cursor-dot-glow: rgba(125, 249, 255, 0.95);
		--cursor-ring: rgba(255, 93, 200, 0.95);
		--cursor-ring-glow: rgba(255, 93, 200, 0.45);
		--cursor-ring-pressed: rgba(125, 249, 255, 0.95);
		--cursor-ring-pressed-glow: rgba(125, 249, 255, 0.65);
		--overlay-opacity: 0.06;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
		font-family: var(--font-body);
		color: var(--text);
		background:
			radial-gradient(circle at 85% 5%, var(--bg-accent-1) 0%, transparent 25%),
			radial-gradient(circle at 10% 80%, var(--bg-accent-2) 0%, transparent 35%),
			linear-gradient(180deg, var(--bg-2) 0%, var(--bg) 65%);
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-display);
		letter-spacing: var(--heading-letter-spacing);
		line-height: var(--heading-line-height);
		word-spacing: var(--heading-word-spacing);
		color: var(--heading);
	}

	h1 a,
	h2 a,
	h3 a {
		color: inherit;
	}

	a {
		color: inherit;
	}

	:global(body.has-custom-cursor),
	:global(body.has-custom-cursor a),
	:global(body.has-custom-cursor button),
	:global(body.has-custom-cursor [role='button']) {
		cursor: none !important;
	}

	:global(.cursor-dot) {
		position: fixed;
		top: 0;
		left: 0;
		width: 12px;
		height: 12px;
		border-radius: 999px;
		background: var(--cursor-dot);
		box-shadow:
			0 0 0 1px rgba(0, 0, 0, 0.55),
			0 0 24px var(--cursor-dot-glow);
		z-index: 12000;
		pointer-events: none;
		will-change: transform;
		opacity: 1;
	}

	:global(.cursor-ring) {
		position: fixed;
		top: 0;
		left: 0;
		width: 40px;
		height: 40px;
		border-radius: 999px;
		border: 2px solid var(--cursor-ring);
		box-shadow: 0 0 18px var(--cursor-ring-glow);
		z-index: 11999;
		pointer-events: none;
		will-change: transform;
		transition:
			transform 110ms ease,
			border-color 180ms ease,
			box-shadow 180ms ease;
		opacity: 1;
	}

	:global(.cursor-ring.pressed) {
		border-color: var(--cursor-ring-pressed);
		box-shadow: 0 0 24px var(--cursor-ring-pressed-glow);
	}

	:global(.cursor-coordinates) {
		position: fixed;
		left: 50%;
		transform: translateX(-50%);
		bottom: 4.6rem;
		padding: 0.45rem 0.7rem;
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 8px;
		background: var(--surface);
		color: var(--accent);
		font-family: 'Press Start 2P', ui-monospace, 'Cascadia Code', Consolas, monospace;
		font-size: 0.65rem;
		letter-spacing: 0.04em;
		z-index: 11998;
		backdrop-filter: blur(3px);
		text-shadow: 0 0 8px color-mix(in srgb, var(--accent) 65%, transparent);
	}

	:global(.car-selector) {
		position: relative;
	}

	:global(.car-button) {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.45rem 0.65rem;
		border-radius: 10px;
		border: 1px solid var(--header-link-border);
		background: var(--header-link-bg);
		color: var(--accent);
		cursor: pointer;
		z-index: 10042;
	}

	:global(.car-button .label) {
		font-size: 0.75rem;
		white-space: nowrap;
	}

	:global(.car-menu) {
		position: absolute;
		top: calc(100% + 0.4rem);
		right: 0;
		display: grid;
		gap: 0.3rem;
		width: 180px;
		padding: 0.5rem;
		border-radius: 12px;
		border: 1px solid var(--panel-border);
		background: var(--surface-strong);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25);
		z-index: 10060;
	}

	:global(.speed-control) {
		display: grid;
		gap: 0.25rem;
		padding: 0.2rem 0.3rem 0.45rem;
		border-bottom: 1px solid var(--panel-border);
		margin-bottom: 0.25rem;
	}

	:global(.speed-control label) {
		font-size: 0.7rem;
		color: var(--muted);
	}

	:global(.speed-control input) {
		width: 100%;
	}

	:global(.car-option) {
		text-align: left;
		padding: 0.4rem 0.5rem;
		border: 1px solid transparent;
		border-radius: 8px;
		background: transparent;
		color: var(--text);
		cursor: pointer;
	}

	:global(.car-option:hover),
	:global(.car-option.active) {
		border-color: var(--panel-border);
		background: var(--surface);
	}

	:global(.sprite-follower) {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 3000;
	}

	:global(.sprite-follower .sprite-car) {
		position: fixed;
		top: 0;
		left: 0;
		width: 64px;
		height: 64px;
		will-change: transform;
		filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.45));
		z-index: 3001;
	}

	:global(.sprite-follower .sprite-particle) {
		position: fixed;
		top: 0;
		left: 0;
		pointer-events: none;
		image-rendering: pixelated;
		z-index: 3002;
	}

	.stars {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: -4;
	}

	.stars-far {
		background-image: radial-gradient(rgba(255, 255, 255, 0.55) 1px, transparent 1px);
		background-size: 6px 6px;
		opacity: 0.26;
		animation: star-drift 120s linear infinite;
	}

	.stars-mid {
		background-image:
			radial-gradient(rgba(125, 249, 255, 0.8) 1px, transparent 1px),
			radial-gradient(rgba(255, 93, 200, 0.75) 1px, transparent 1px);
		background-size:
			11px 11px,
			15px 15px;
		background-position:
			0 0,
			3px 6px;
		opacity: 0.28;
		animation: star-drift 80s linear infinite reverse;
	}

	.stars-near {
		background-image: radial-gradient(rgba(255, 200, 87, 0.95) 1px, transparent 1px);
		background-size: 19px 19px;
		opacity: 0.3;
		animation: star-shimmer 5s ease-in-out infinite;
	}

	:root[data-theme='light'] .stars,
	:root[data-theme='light'] .nebula-overlay,
	:root[data-theme='light'] .scanline-overlay {
		opacity: 0;
	}

	.nebula-overlay {
		position: fixed;
		inset: 0;
		background:
			radial-gradient(circle at 20% 30%, rgba(125, 249, 255, 0.16), transparent 45%),
			radial-gradient(circle at 72% 72%, rgba(255, 93, 200, 0.14), transparent 50%);
		pointer-events: none;
		z-index: -3;
	}

	.scanline-overlay {
		position: fixed;
		inset: 0;
		background-image: linear-gradient(to bottom, transparent 0, rgba(0, 0, 0, 0.16) 50%, transparent 100%);
		background-size: 100% 3px;
		opacity: var(--overlay-opacity);
		pointer-events: none;
		z-index: -2;
	}

	.site-header {
		position: sticky;
		top: 0;
		padding: 0.8rem 0;
		backdrop-filter: blur(10px);
		background: var(--header-bg);
		border-bottom: 1px solid var(--header-border);
		overflow: visible;
		z-index: 10040;
	}

	.header-inner {
		width: min(1120px, 92vw);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand {
		text-decoration: none;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-family: var(--font-display);
		color: var(--header-brand);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		flex-wrap: wrap;
		justify-content: flex-end;
		position: relative;
		z-index: 10041;
	}

	nav {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	nav a {
		text-decoration: none;
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--header-link-border);
		border-radius: 999px;
		background: var(--header-link-bg);
		transition:
			background-color 180ms ease,
			border-color 180ms ease;
	}

	nav a:hover {
		border-color: var(--panel-border);
		background: var(--header-link-hover);
	}

	:global(.theme-toggle) {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		border: 1px solid var(--header-link-border);
		background: var(--header-link-bg);
		color: var(--accent);
		padding: 0;
		cursor: pointer;
		flex-shrink: 0;
		min-width: 2.25rem;
		min-height: 2.25rem;
		z-index: 10042;
	}

	:global(.theme-toggle .icon-fallback) {
		opacity: 0.45;
		font-size: 0.75rem;
	}

	:global(.theme-toggle .icon) {
		position: absolute;
		width: 1rem;
		height: 1rem;
		opacity: 0;
		transform: scale(0.65);
		transition:
			opacity 180ms ease,
			transform 180ms ease;
	}

	:global(.theme-toggle .icon.visible) {
		opacity: 1;
		transform: scale(1);
	}

	:global(.theme-toggle svg) {
		width: 100%;
		height: 100%;
		display: block;
	}

	main {
		width: min(1120px, 92vw);
		margin: 0 auto;
		padding: 2.25rem 0 3rem;
	}

	.site-footer {
		width: min(1120px, 92vw);
		margin: 0 auto;
		padding: 0 0 3.5rem;
		color: var(--muted);
	}

	@keyframes star-drift {
		0% {
			transform: translateY(0);
		}
		100% {
			transform: translateY(180px);
		}
	}

	@keyframes star-shimmer {
		0%,
		100% {
			opacity: 0.12;
		}
		50% {
			opacity: 0.3;
		}
	}

	@media (max-width: 860px) {
		.header-inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.6rem;
		}

		.header-actions {
			width: 100%;
			justify-content: space-between;
		}

		nav {
			gap: 0.5rem;
		}
	}
</style>
