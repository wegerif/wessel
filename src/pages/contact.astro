---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPageContentBySlug } from '../lib/wordpress';

const contactPage = await getPageContentBySlug('contact');
---

<SiteLayout title="Contact | Wessel Wegerif" description="Get in touch with Wessel Wegerif.">
	<section class="contact-page">
		<h1>{contactPage?.title ?? 'Contact'}</h1>
		<p class="lead">{contactPage?.text ?? 'Contact details are being prepared.'}</p>
		<div class="actions">
			<a href="mailto:wessel.wegerif@gmail.com">Email me</a>
			<a href="https://www.linkedin.com" target="_blank" rel="noreferrer">LinkedIn</a>
			<a href="https://github.com" target="_blank" rel="noreferrer">GitHub</a>
		</div>
	</section>
</SiteLayout>

<style>
	.contact-page {
		max-width: 760px;
		margin: 0 auto;
	}

	.lead {
		color: var(--muted);
		line-height: 1.8;
	}

	.actions {
		margin-top: 1.1rem;
		display: flex;
		gap: 0.7rem;
		flex-wrap: wrap;
	}

	.actions a {
		text-decoration: none;
		padding: 0.5rem 0.9rem;
		border-radius: 10px;
		border: 1px solid var(--panel-border);
		background: var(--panel-bg);
	}
</style>
