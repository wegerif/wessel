---
import HeroConsole from '../components/HeroConsole';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getLatestPosts, getPageContentBySlug, getPostPreviewText, getPostTitleText } from '../lib/wordpress';

const [posts, aboutPage, contactPage] = await Promise.all([
	getLatestPosts(4),
	getPageContentBySlug('about'),
	getPageContentBySlug('contact'),
]);

const aboutPreview = aboutPage?.text
	? `${aboutPage.text.slice(0, 220)}...`
	: 'About page content is being prepared.';
const contactPreview = contactPage?.text
	? `${contactPage.text.slice(0, 220)}...`
	: 'Contact details are being prepared.';
---

<SiteLayout
	title="Wessel Wegerif | Developer Portfolio"
	description="Creative developer portfolio and posts by Wessel Wegerif."
>
	<section class="hero">
		<div class="hero-copy">
			<p class="tag">Developer portfolio - custom built from scratch</p>
			<h1>Van designer naar developer</h1>
			<p class="intro">
				Ik ontwerp, bouw en maak data-driven dingen websites, met een unieke look en feel.
				Dit is mijn digitale speeltuin.
			</p>
			<div class="buttons">
				<a href="/posts">Posts</a>
				<a href="/about">Over mij</a>
			</div>
		</div>
		<div class="hero-terminal">
			<HeroConsole client:load />
		</div>
	</section>

	<section class="card-grid">
		<a class="card card-link" href="/about">
			<h2>{aboutPage?.title ?? 'About me'}</h2>
			<p>{aboutPreview}</p>
		</a>
		<a class="card card-link" href="/contact">
			<h2>Contact</h2>
			<p>{contactPreview}</p>
		</a>
		<a class="card card-link" href="/style-lab">
			<h2>Stack right now</h2>
			<p>TypeScript, Astro, React, CSS animation, and API-driven architecture.</p>
		</a>
	</section>

	<section class="latest">
		<div class="section-title">
			<h2>Latest posts</h2>
			<a href="/posts">View all</a>
		</div>
		<div class="posts">
			{
				posts.map((post) => (
					<article class="post">
						<h3>
							<a href={`/posts/${post.slug}`}>{getPostTitleText(post)}</a>
						</h3>
						<p>{getPostPreviewText(post, 180)}</p>
					</article>
				))
			}
		</div>
	</section>
</SiteLayout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 1.5rem;
		align-items: center;
		animation: section-in 700ms ease;
	}

	.tag {
		font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
		color: var(--accent);
		margin-bottom: 0.75rem;
	}

	h1 {
		font-size: clamp(2rem, 6vw, 4.2rem);
		line-height: 1;
		margin: 0;
		text-wrap: balance;
	}

	.intro {
		color: var(--muted);
		max-width: 58ch;
	}

	.buttons {
		display: flex;
		gap: 0.8rem;
		flex-wrap: wrap;
		margin-top: 1.2rem;
	}

	.buttons a {
		text-decoration: none;
		border: 1px solid var(--panel-border);
		padding: 0.55rem 0.95rem;
		border-radius: 10px;
		background: var(--surface);
	}

	.buttons a:first-child {
		background: linear-gradient(45deg, var(--accent), var(--accent-2), var(--accent-3));
		color: #05070f;
		border: 0;
		font-weight: 700;
	}

	.hero-terminal {
		background: var(--panel-bg);
		border: 1px solid var(--panel-border);
		border-radius: 16px;
		padding: 1.2rem;
		min-height: 220px;
		box-shadow: 0 12px 30px rgba(3, 6, 18, 0.55);
	}

	:global(.hero-console) {
		font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
		color: var(--accent);
	}

	:global(.hero-console p) {
		margin: 0 0 0.6rem;
	}

	.card-grid {
		margin-top: 2rem;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		animation: section-in 950ms ease;
	}

	.card {
		background: var(--panel-bg);
		border: 1px solid var(--panel-border);
		border-radius: 16px;
		padding: 1rem;
		transition:
			transform 220ms ease,
			border-color 220ms ease;
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: var(--panel-hover);
	}

	.card-link {
		text-decoration: none;
	}

	.card h2 {
		margin-top: 0;
		font-size: 1.1rem;
	}

	.card p {
		color: var(--muted);
		margin-bottom: 0;
	}

	.latest {
		margin-top: 2.5rem;
		animation: section-in 1200ms ease;
	}

	.section-title {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.section-title a {
		color: var(--accent);
	}

	.posts {
		margin-top: 0.8rem;
		display: grid;
		gap: 0.85rem;
	}

	.post {
		background: var(--panel-bg);
		border: 1px solid var(--panel-border);
		border-radius: 14px;
		padding: 1rem;
		transition:
			transform 220ms ease,
			border-color 220ms ease;
	}

	.post:hover {
		transform: translateX(4px);
		border-color: var(--panel-hover);
	}

	.post h3 {
		margin: 0 0 0.5rem;
	}

	.post h3 a {
		text-decoration: none;
	}

	:global(.post p) {
		margin: 0;
		color: var(--muted);
	}

	.logo-showcase {
		margin-top: 1.8rem;
		animation: section-in 850ms ease;
	}

	.light-panel {
		background: linear-gradient(180deg, #ffffff, #f2f6ff);
		color: #0f172d;
		border-radius: 14px;
		padding: 1rem 1.1rem;
		border: 1px solid rgba(255, 255, 255, 0.8);
	}

	.light-panel .label {
		font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
		color: #27366a;
		margin: 0 0 0.45rem;
	}

	.light-panel p:last-child {
		margin: 0;
	}

	@keyframes section-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
		}

		.card-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
