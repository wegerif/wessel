---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getAllPosts, getPostPreviewText, getPostTitleText } from '../lib/wordpress';

const posts = await getAllPosts();
---

<SiteLayout title="Posts | Wessel Wegerif" description="Development notes and creative work by Wessel.">
	<section class="posts-list">
		<h1>Posts</h1>
		<p>
			A unified feed of native WordPress posts and legacy portfolio items while migration is in
			progress.
		</p>
		<div class="items">
			{
				posts.map((post) => (
					<article class="item">
						<time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-GB')}</time>
						<p class="type">{post.source === 'portfolio' ? 'Portfolio archive' : 'Post'}</p>
						<h2>
							<a href={`/posts/${post.slug}`}>{getPostTitleText(post)}</a>
						</h2>
						<p class="summary">{getPostPreviewText(post, 220)}</p>
						<a class="read-link" href={`/posts/${post.slug}`}>Open post -></a>
					</article>
				))
			}
		</div>
	</section>
</SiteLayout>

<style>
	.posts-list > p {
		color: var(--muted);
		max-width: 60ch;
	}

	.items {
		margin-top: 1rem;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.item {
		padding: 1.1rem;
		border-radius: 16px;
		background: var(--panel-bg);
		border: 1px solid var(--panel-border);
		transition:
			transform 220ms ease,
			border-color 220ms ease;
	}

	.item:hover {
		transform: translateY(-5px);
		border-color: var(--panel-hover);
	}

	.item time {
		color: var(--accent);
		font-size: 0.9rem;
	}

	.item .type {
		margin: 0.25rem 0;
		font-size: 0.8rem;
		color: var(--accent-2);
	}

	.item h2 {
		margin: 0.4rem 0;
		font-size: 1.2rem;
	}

	.item h2 a {
		text-decoration: none;
	}

	.summary {
		margin: 0;
		color: var(--muted);
		line-height: 1.6;
	}

	.read-link {
		display: inline-block;
		margin-top: 0.8rem;
		color: var(--accent-3);
		text-decoration: none;
		font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
	}

	@media (max-width: 820px) {
		.items {
			grid-template-columns: 1fr;
		}
	}
</style>
