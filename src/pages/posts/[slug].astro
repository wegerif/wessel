---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getAllPosts, type SitePost } from '../../lib/wordpress';

export async function getStaticPaths() {
	const posts = await getAllPosts();
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props as { post: SitePost };
---

<SiteLayout title={`${post.title.rendered} | Wessel Wegerif`} description={`Post: ${post.title.rendered}`}>
	<article class="post">
		<p class="meta">
			{new Date(post.date).toLocaleDateString('en-GB')} - {post.source === 'portfolio'
				? 'Portfolio archive'
				: 'WordPress post'}
		</p>
		<h1 set:html={post.title.rendered} />
		<div class="content" set:html={post.content.rendered} />
	</article>
</SiteLayout>

<style>
	.post {
		max-width: 760px;
		margin: 0 auto;
		padding: 1.2rem;
		border-radius: 16px;
		background: rgba(12, 9, 25, 0.82);
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.meta {
		color: var(--accent);
		font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
	}

	h1 {
		text-wrap: balance;
	}

	:global(.content p) {
		line-height: 1.75;
		color: var(--muted);
	}

	:global(.content a) {
		color: var(--accent);
	}
</style>
