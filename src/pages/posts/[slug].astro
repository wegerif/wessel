---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getAllPosts, getPostTitleText, type SitePost } from '../../lib/wordpress';

export async function getStaticPaths() {
	const posts = await getAllPosts();
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props as { post: SitePost };
const postTitle = getPostTitleText(post);
---

<SiteLayout title={`${postTitle} | Wessel Wegerif`} description={`Post: ${postTitle}`}>
	<article class="post">
		<p class="meta">{new Date(post.date).toLocaleDateString('en-GB')}</p>
		<h1>{postTitle}</h1>
		<div class="content" set:html={post.content.rendered} />
	</article>
</SiteLayout>

<style>
	.post {
		max-width: 760px;
		margin: 0 auto;
		padding: 1.4rem;
		border-radius: 18px;
		background: var(--panel-bg);
		border: 1px solid var(--panel-border);
		box-shadow: 0 12px 32px rgba(2, 6, 14, 0.55);
	}

	.meta {
		color: var(--accent);
		font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
	}

	h1 {
		text-wrap: balance;
		line-height: 1.1;
		margin-top: 0.35rem;
	}

	:global(.content p) {
		line-height: 1.75;
		color: var(--muted);
	}

	:global(.content a) {
		color: var(--accent);
	}

	:global(.content h2),
	:global(.content h3) {
		color: var(--text);
		margin-top: 1.4rem;
	}

	:global(.content img) {
		max-width: 100%;
		height: auto;
		border-radius: 12px;
		border: 1px solid var(--panel-border);
	}

	:global(.content iframe) {
		max-width: 100%;
		border-radius: 12px;
		border: 1px solid var(--panel-border);
	}
</style>
